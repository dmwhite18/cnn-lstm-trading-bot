# Copy this file to `.env` and fill in your own Alpaca API credentials.
# `.env` is git-ignored — never commit real keys. Prefer the PAPER endpoint.

ALPACA_KEY_ID=your_key_id_here
ALPACA_SECRET_KEY=your_secret_key_here

# Paper (default) vs live. Leave as paper unless you really mean it.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_BASE_URL=https://api.alpaca.markets
